{
  "name": "capy-through-time",
  "productName": "Capy Through Time",
  "version": "1.0.0",
  "description": "Capy Through Time — Капі крізь час: піксельна гра-клікер про капібару Капі",
  "author": "Capy",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "prepare-game": "node prepare.js",
    "start": "node prepare.js && electron .",
    "debug": "node prepare.js && electron . --debug",
    "dist": "node prepare.js && electron-builder --win",
    "dist:installer": "node prepare.js && electron-builder --win nsis",
    "dist:portable": "node prepare.js && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.capy.throughtime",
    "productName": "Capy Through Time",
    "copyright": "Capy Through Time",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json",
      "app/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Capy Through Time",
      "artifactName": "CapyThroughTime-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "CapyThroughTime-Portable-${version}.exe"
    }
  }
}
